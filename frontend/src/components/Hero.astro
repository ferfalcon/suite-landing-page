---
import heroLandscape from '../assets/image-hero-landscape.webp';
import heroLandscape2x from '../assets/image-hero-landscape@2x.webp';
import heroPortrait from '../assets/image-hero-portrait.webp';
import heroPortrait2x from '../assets/image-hero-portrait@2x.webp';
import heroStroke from '../assets/pattern-curved-line-1.svg';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__content">
		<div class="hero__copy">
			<h1 id="hero-title" class="hero__title">
				<span class="hero__title-line">A <strong>super solution</strong></span>
				<span class="hero__title-line">for your <strong>business.</strong></span>
			</h1>
			<p class="hero__body">Our marketing and sales automations help you scale your outreach to get more leads for your company.</p>
			<img class="hero__stroke" src={heroStroke.src} alt="" aria-hidden="true" />
		</div>
		<a class="cta cta--primary" href="#">Request Beta Access</a>
	</div>

	<picture class="hero__visual" aria-hidden="true">
		<source media="(max-width: 619px)" srcset={`${heroLandscape.src} 1x, ${heroLandscape2x.src} 2x`} />
		<img src={heroPortrait.src} srcset={`${heroPortrait.src} 1x, ${heroPortrait2x.src} 2x`} alt="" />
	</picture>
</section>

<style>
	.hero {
		position: relative;
		block-size: 600px;
		min-inline-size: 0;
	}

	.hero__content {
		position: absolute;
		z-index: 2;
		top: 110px;
		left: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-64);
		inline-size: min(635px, 70%);
	}

	.hero__copy {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-40);
		inline-size: 100%;
	}

	.hero__title {
		margin: 0;
		color: var(--color-text-primary);
		font-size: 72px;
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -1px;
	}

	.hero__title-line {
		display: block;
		white-space: nowrap;
	}

	.hero__title strong {
		font-weight: 700;
	}

	.hero__body {
		inline-size: 350px;
		max-inline-size: 100%;
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 18px;
		line-height: 1.6;
		letter-spacing: 0.1px;
	}

	.hero__stroke {
		position: absolute;
		top: -52px;
		left: 289px;
		inline-size: 289px;
		max-inline-size: none;
		pointer-events: none;
	}

	.hero__visual {
		position: absolute;
		top: 24px;
		left: 474px;
		display: block;
		inline-size: 350px;
		block-size: 576px;
		overflow: hidden;
		border-radius: 15px;
	}

	.hero__visual img {
		inline-size: 100%;
		block-size: 600px;
		max-inline-size: none;
		object-fit: cover;
	}

	@media (max-width: 1040px) and (min-width: 620px) {
		.hero {
			block-size: 480px;
		}

		.hero__content {
			top: 87px;
			gap: var(--space-48);
			inline-size: calc(100% - 69px);
		}

		.hero__title {
			font-size: 56px;
			letter-spacing: -0.78px;
		}

		.hero__stroke {
			top: -63px;
			left: 45.5%;
		}

		.hero__visual {
			top: 0;
			left: auto;
			right: 0;
			inline-size: 39.77%;
			block-size: 480px;
		}

		.hero__visual img {
			block-size: 480px;
		}
	}

	@media (max-width: 619px) {
		.hero {
			display: flex;
			flex-direction: column;
			gap: var(--space-64);
			block-size: auto;
			overflow: hidden;
		}

		.hero__content {
			position: relative;
			top: auto;
			left: auto;
			gap: var(--space-40);
			inline-size: 100%;
		}

		.hero__copy {
			gap: var(--space-24);
		}

		.hero__title {
			font-size: 38px;
			letter-spacing: -0.528px;
		}

		.hero__title-line {
			white-space: normal;
		}

		.hero__stroke {
			top: -24px;
			left: 49%;
			inline-size: 128px;
		}

		.hero__visual {
			position: relative;
			top: auto;
			left: auto;
			inline-size: 100%;
			block-size: auto;
			aspect-ratio: 343 / 240;
		}

		.hero__visual img {
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
		}
	}

	@media (max-width: 340px) {
		.hero__title {
			font-size: 34px;
		}

		.hero__stroke {
			left: 46%;
		}
	}
</style>
