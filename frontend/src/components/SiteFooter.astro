---
import facebookIcon from '../assets/icon-facebook.svg';
import instagramIcon from '../assets/icon-instagram.svg';
import logo from '../assets/logo.svg';
import twitterIcon from '../assets/icon-twitter.svg';

const socialLinks = [
	{ name: 'Facebook', icon: facebookIcon },
	{ name: 'Twitter', icon: twitterIcon },
	{ name: 'Instagram', icon: instagramIcon },
];
---

<footer class="site-footer">
	<div class="site-footer__content">
		<img class="site-footer__logo" src={logo.src} alt="" aria-hidden="true" />
		<p class="site-footer__copyright">Copyright - Suite</p>
		<nav class="site-footer__social" aria-label="Social media">
			{socialLinks.map(({ name, icon }) => (
				<a class="site-footer__social-link" href="#">
					<span class="site-footer__social-name">{name}</span>
					<img src={icon.src} alt="" aria-hidden="true" />
				</a>
			))}
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		inline-size: 100%;
		block-size: 464px;
		padding: 80px max(32px, calc((100% - 1106px) / 2));
		background: var(--color-background-surface);
	}

	.site-footer__content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		inline-size: min(1106px, 100%);
	}

	.site-footer__logo {
		inline-size: 79px;
		block-size: 26px;
	}

	.site-footer__copyright {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 15px;
		line-height: 1.6;
		text-align: center;
		white-space: nowrap;
	}

	.site-footer__social {
		display: flex;
		align-items: center;
		gap: var(--space-32);
	}

	.site-footer__social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 44px;
		block-size: 44px;
		margin-inline: -12px;
		border-radius: var(--radius-4);
		text-decoration: none;
	}

	.site-footer__social-link img {
		inline-size: 20px;
		block-size: 20px;
		max-inline-size: none;
	}

	.site-footer__social-link:nth-child(2) img {
		block-size: auto;
	}

	.site-footer__social-name {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1040px) and (min-width: 620px) {
		.site-footer {
			padding: 80px 32px 40px;
		}
	}

	@media (max-width: 619px) {
		.site-footer {
			padding: 80px 32px 40px;
		}

		.site-footer__content {
			flex-direction: column;
			justify-content: flex-start;
			gap: var(--space-32);
		}
	}
</style>
