---
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Testimonial from '../components/Testimonial.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-content">
		<SiteHeader />
		<div class="upper-page">
			<Hero />
			<Metrics />
		</div>
		<Testimonial />
	</main>
	<SiteFooter />
</Layout>

<style>
	.page-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-80);
		inline-size: min(1110px, calc(100% - 64px));
		margin-inline: auto;
		padding-block-start: 50px;
	}

	.upper-page {
		display: grid;
		grid-template-columns: minmax(0, 920px) 190px;
		inline-size: 100%;
	}

	.upper-page :global(.metrics) {
		margin-block-start: -8px;
	}

	.page-content > :global(.testimonial) {
		margin-block-start: 110px;
	}

	:global(.site-footer) {
		margin-block-start: -255px;
	}

	@media (max-width: 1040px) {
		.page-content {
			padding-block-start: var(--space-32);
		}

		.upper-page {
			display: flex;
			flex-direction: column;
			gap: var(--space-80);
		}

		.upper-page :global(.metrics) {
			margin-block-start: 0;
		}

		.page-content > :global(.testimonial) {
			margin-block-start: 186px;
		}

		:global(.site-footer) {
			margin-block-start: -320px;
		}
	}

	@media (max-width: 900px) and (min-width: 620px) {
		.page-content > :global(.testimonial) {
			margin-block-start: 186px;
		}
	}

	@media (max-width: 619px) {
		.page-content {
			gap: var(--space-64);
			inline-size: min(100% - 32px, 560px);
			padding-block-start: var(--space-24);
		}

		.upper-page {
			gap: var(--space-64);
		}

		.page-content > :global(.testimonial) {
			inline-size: 100vw;
			margin-block-start: 221px;
			margin-inline-start: calc(50% - 50vw);
		}

		:global(.site-footer) {
			margin-block-start: -235px;
		}
	}

	@media (max-width: 340px) {
		.page-content {
			inline-size: calc(100% - 24px);
		}
	}
</style>
